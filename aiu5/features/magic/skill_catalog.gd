# Defines the five elemental trunk skills, their costs, effects and player controls.
extends RefCounted
const KEYS := ["被动", "Z", "H", "K", "L"]
const COSTS := [0, 5, 5, 10, 10]
const NAMES := {
	"wood": ["生机", "武器赋能", "催熟", "回春", "藤蔓汲取"],
	"water": ["节水", "武器赋能", "注水", "水盾", "水泡禁锢"],
	"fire": ["耐饥", "武器赋能", "引火", "灼烧", "火球"],
	"earth": ["疾跑", "武器赋能", "开垦", "土屋", "瞬移"]}
const DESCRIPTIONS := {
	"wood": ["生命上限＋1，点亮时生命＋1。", "武器攻击＋2，持续120秒；重复施放刷新时间，不叠加。", "鼠标指向附近一格活作物，立即成熟。", "每3秒回复1点生命，持续30秒。", "目标敌人禁锢1秒；下次武器命中汲取2点生命。"],
	"water": ["饥渴值的自然消耗速度减慢10%。", "武器攻击＋2，持续120秒；重复施放刷新时间，不叠加。", "背包内一个空水桶和一个空木杯立即装满。", "受到的伤害减少30%，持续30秒。", "敌人禁锢1秒；随后10秒内每5秒扣2点饥渴。"],
	"fire": ["饥饿值的自然消耗速度减慢10%。", "武器攻击＋2，持续120秒；重复施放刷新时间，不叠加。", "点燃附近篝火及已装备的火把。", "目标敌人每3秒扣1点生命，持续15秒。", "朝鼠标方向发射一个火球，命中造成5点伤害。"],
	"earth": ["跑步速度增加10%。", "武器攻击＋2，持续120秒；重复施放刷新时间，不叠加。", "鼠标位置最多开垦5×5格有效土地，无需锄头。", "鼠标位置生成仅自己可进入的土屋，20秒后消失。", "朝鼠标方向瞬移80世界像素，落点需安全。"]}
static func entry(element: String, rank: int) -> Dictionary:
	var index := clampi(rank - 1, 0, 4)
	return {"rank":rank,"name":NAMES.get(element,["一级", "二级", "三级", "四级", "五级"])[index],
		"description":DESCRIPTIONS.get(element,["请先觉醒一种属性。", "请先觉醒一种属性。", "请先觉醒一种属性。", "请先觉醒一种属性。", "请先觉醒一种属性。"])[index],
		"key":KEYS[index],"mana_cost":COSTS[index]}
